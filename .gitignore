# build products and render output, only where AGENTS.md 構成の目標 4 lets them be: an out/ anywhere else shows in git status
/engine/out/
/docs/internal/**/out/
third_party/
# clangd's index
.cache/
# (engine/third_party holds what the build fetches, kept out, beside a few small bundled works, kept in: a new one is let in below)
!/engine/third_party/
/engine/third_party/*
!/engine/third_party/anime/
!/engine/third_party/godot_easing/
!/engine/third_party/js/
!/engine/third_party/leva/
!/engine/third_party/midi_roll/
!/engine/third_party/thermion_frame/
!/engine/third_party/ymm4-luascript/
!/engine/third_party/wordnet_ja/
!/engine/third_party/noto_sans_jp/
!/engine/third_party/gflanguages/
/engine/third_party/js/hermes/
/engine/third_party/midi_roll/PianoRollSvg.js
target/
build/
node_modules/
*.filamat
*.o
*.dSYM/
.DS_Store

# Python's bytecode, from the scripts under shelves/ and .githooks/
__pycache__/
# Kept on this machine only, not in git: the reports' pictures and films (many show other people's apps or footage),
# Windows binaries inside the AviUtl2 packages (Motolii runs on macOS), and packages whose author gives no licence text.
/docs/internal/reports/**/*.png
/docs/internal/reports/**/*.jpg
/docs/internal/reports/**/*.jpeg
/docs/internal/reports/**/*.mp4
/docs/internal/reports/**/*.gif
/docs/internal/reports/**/*.webm
/shelves/aviutl_scripts/**/*.mod2
/shelves/aviutl_scripts/**/*.aux2
/shelves/aviutl_scripts/**/*.exe
/shelves/aviutl_scripts/**/*.dll
/shelves/aviutl_scripts/HexBrowns__AviUtl2Browser_H/Script/browser/exe/
/shelves/aviutl_scripts/Korarei__Constraint/
/shelves/aviutl_scripts/Natadecoco2539__TextBackplate/
/shelves/aviutl_scripts/Tettu0530__NCS風音声波形__NCSAudioVisualizer_/
/shelves/aviutl_scripts/zopty__光学モーションブラー/
/shelves/aviutl_scripts/もも猫__ウェーブクリッピング/
/shelves/aviutl_scripts/もも猫__スカラップ円/
/shelves/aviutl_scripts/もも猫__ルーローの多角形/
/shelves/aviutl_scripts/暘_弥涼__SliceGlitch/
/docs/internal/reports/window/user_panels/sheets/youtube/
/build.motolii
/docs/internal/reports/window/user_panels/
/docs/internal/reports/window/skin_run/*.motolii
# what the window tests shoot; the pictures the READMEs show are .jpg made from them
/docs/pictures/*.png
# Claude Code's folder (code.claude.com/docs/en/settings): settings.json and hooks/ are the project's, kept in git as
# f12f6d031 had them; the rest is one person's: settings.local.json, worktrees/, a lead's notes and locks, and a
# launch.json naming its own session's scratchpad
/.claude/*
!/.claude/settings.json
!/.claude/hooks/
# Cursor's folder: one person's editor. Its rules repeat AGENTS.md, which Cursor reads itself (cursor.com/docs/context/rules),
# and its stop hook reads reports/alight_checklist.md, which is gone
/.cursor/
