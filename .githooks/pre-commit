#!/bin/sh
# Before every commit: is every file of our own still one job, 500 lines at most? (.githooks/size_check.py)
# Then: does the tree still keep the layout of AGENTS.md 「構成の目標」? (.githooks/layout_check.py)
# Set up once with:  git config core.hooksPath .githooks        To commit all the same:  git commit --no-verify
# A check this worktree does not have yet (a branch cut before it was added) is skipped, not a crash.
hooks="$(git rev-parse --show-toplevel)/.githooks"
for check in size_check.py layout_check.py; do
    [ -f "$hooks/$check" ] || continue
    python3 "$hooks/$check" || exit 1
done
