    R[36] = max(SPECTRAL_EPSILON, w * 1.0005449892705800 + c * 0.0145044507314479 + m * 0.9722802433068740 + y * 0.9847029256150900 + r * 0.9856958798482050 + g * 0.0281271086805816 + b * 0.0157648147772649);
    R[37] = max(SPECTRAL_EPSILON, w * 1.0005449969930000 + c * 0.0145038009464639 + m * 0.9722813248265600 + y * 0.9847028681227950 + r * 0.9856965214637620 + g * 0.0281260133612096 + b * 0.0157648801149616);
}

float3 spectral_xyz_to_srgb(float3 xyz)
{
    float3x3 XYZ_RGB;

    XYZ_RGB[0] = float3( 3.2409699419045200, -1.537383177570090, -0.4986107602930030);
    XYZ_RGB[1] = float3(-0.9692436362808790,  1.875967501507720,  0.0415550574071756);
    XYZ_RGB[2] = float3( 0.0556300796969936, -0.203976958888976,  1.0569715142428700);

    float r = dot(XYZ_RGB[0], xyz);
    float g = dot(XYZ_RGB[1], xyz);
    float b = dot(XYZ_RGB[2], xyz);

    return spectral_linear_to_srgb(float3(r, g, b));
}

float3 spectral_reflectance_to_xyz(float R[SPECTRAL_SIZE])
{
    float3 xyz = float3(0.0, 0.0, 0.0);

    xyz += R[ 0] * float3(0.0000646919989576, 0.0000018442894440, 0.0003050171476380);
    xyz += R[ 1] * float3(0.0002194098998132, 0.0000062053235865, 0.0010368066663574);
    xyz += R[ 2] * float3(0.0011205743509343, 0.0000310096046799, 0.0053131363323992);
    xyz += R[ 3] * float3(0.0037666134117111, 0.0001047483849269, 0.0179543925899536);
    xyz += R[ 4] * float3(0.0118805536037990, 0.0003536405299538, 0.0570775815345485);
    xyz += R[ 5] * float3(0.0232864424191771, 0.0009514714056444, 0.1136516189362870);
    xyz += R[ 6] * float3(0.0345594181969747, 0.0022822631748318, 0.1733587261835500);
    xyz += R[ 7] * float3(0.0372237901162006, 0.0042073290434730, 0.1962065755586570);
    xyz += R[ 8] * float3(0.0324183761091486, 0.0066887983719014, 0.1860823707062960);
    xyz += R[ 9] * float3(0.0212332056093810, 0.0098883960193565, 0.1399504753832070);
    xyz += R[10] * float3(0.0104909907685421, 0.0152494514496311, 0.0891745294268649);
