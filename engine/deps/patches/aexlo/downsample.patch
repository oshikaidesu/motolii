+	/// Set the rational downsample factor (e.g. `1, 2` for Half preview).
+	pub fn set_downsample(&mut self, num: i16, den: i16) {
+		let scale = PF_RationalScale {
+			num: num.max(1) as A_long,
+			den: den.max(1) as A_u_long,
+		};
+		self.downsample_x = scale;
+		self.downsample_y = scale;
+	}
