# What Motolii's build asks of Homebrew (Homebrew Bundle:  brew bundle).  Xcode, Python 3 and Flutter 3.47.2 are not from here.
# To build: engine/gpu/build.sh, engine/edit.sh
brew "cmake"
brew "ninja"
brew "meson"
brew "pkgconf"
# What the editor links: films (GStreamer), the document (SQLite), AviUtl's scripts (LuaJIT), effects and recipes (QuickJS-ng),
# the shelves' maps telling how alike pictures look (ONNX Runtime)
brew "gstreamer"
brew "sqlite"
brew "luajit"
brew "quickjs-ng"
brew "onnxruntime"
# What the editor runs: writing a film (ffmpeg makes the mp4, kit_draw.h's film)
brew "ffmpeg"
# (not the build: shelves/effects/sources/from_three.py, which makes effects from three.js shaders, wants naga on PATH: brew install naga-cli)
